# Copy to .env and fill in. Never commit .env.

# --- Core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# True only for local development. Defaults to False when unset.
DJANGO_DEBUG=True
# Comma-separated; required when DEBUG is False (e.g. noteswap.com,www.noteswap.com)
DJANGO_ALLOWED_HOSTS=
# Comma-separated full origins for HTTPS forms behind a proxy (e.g. https://noteswap.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Site address used in email links; required when DEBUG is False (e.g. https://noteswap.com)
NOTESWAP_SITE_URL=
DJANGO_TIME_ZONE=Asia/Dhaka

# --- Database ---
# Omit to use the local SQLite file db.sqlite3. Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/noteswap
# DATABASE_URL=

# --- Email ---
# Unset = emails (verification links, password resets) are printed in the runserver terminal.
# For real sending use an SMTP service, e.g. Brevo:
# EMAIL_URL=smtp+tls://YOUR_BREVO_LOGIN:YOUR_SMTP_KEY@smtp-relay.brevo.com:587
# DJANGO_DEFAULT_FROM_EMAIL=NoteSwap <no-reply@your-domain.com>
# New accounts must confirm their email before signing in. Set to "optional" to let
# unverified accounts sign in (e.g. old local test accounts that share one email).
# DJANGO_EMAIL_VERIFICATION=mandatory

# --- Logging (see core/logs.py) ---
# Everything is printed to the console; hosts keep that in their error log.
# DEBUG, INFO (default), WARNING, ERROR or CRITICAL:
# DJANGO_LOG_LEVEL=INFO
# Optional log files (relative paths are inside the project folder; logs/ is git-ignored).
# Each is capped at 5 MB with 5 old copies kept.
# DJANGO_LOG_FILE=logs/noteswap.log
# Only "who did what" and security lines (Premium, moderation, sign-ins):
# DJANGO_AUDIT_LOG_FILE=logs/audit.log
# Who gets an email when the site crashes (only when DJANGO_DEBUG=False and email works).
# Comma-separated, e.g. Your Name <you@example.com>, other@example.com
# DJANGO_ADMINS=

# --- Google sign-in (leave empty to hide the "Continue with Google" button) ---
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Footer credit "Built by NAME" (defaults to Mazharul Islam Sourav, https://mazharsourav.me) ---
# NOTESWAP_DEVELOPER_NAME=
# NOTESWAP_DEVELOPER_URL=

# --- Media (user uploads) ---
# DJANGO_MEDIA_ROOT=

# --- Production hardening (only applied when DJANGO_DEBUG=False) ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# Raise only after HTTPS works on the real domain (e.g. 31536000):
# DJANGO_SECURE_HSTS_SECONDS=0

# --- Demo data: python manage.py seed_demo (see README) ---
# Leave the passwords empty to have them generated and printed once.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
